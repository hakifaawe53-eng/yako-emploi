<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#0f7b4f">
<title>Yako Emploi</title>
<link rel="manifest" href="manifest.webmanifest">
<link rel="icon" href="icon-192.png">
<link rel="apple-touch-icon" href="icon-192.png">
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@400;600;800&display=swap" rel="stylesheet">
<style>
:root{--ink:#14231b;--mute:#5d6b63;--page:#f2f5ef;--card:#fff;--line:#d9e0d6;--green:#0f7b4f;--orange:#b8500a;--greenbg:#e1f2e9;--orangebg:#fdeadb;--on:#fff;color-scheme:light}
@media (prefers-color-scheme:dark){:root{--ink:#e8efe9;--mute:#9db0a4;--page:#0f1612;--card:#17211b;--line:#2a382f;--green:#4cc38a;--orange:#ff9a4d;--greenbg:#183a29;--orangebg:#40281a;--on:#06210f;color-scheme:dark}}
*{box-sizing:border-box}
body{margin:0;background:var(--page);color:var(--ink);font:16px/1.5 "Bricolage Grotesque",system-ui,sans-serif;padding:env(safe-area-inset-top,0) 0 env(safe-area-inset-bottom,0)}
[hidden]{display:none!important}
.wrap{max-width:640px;margin:0 auto;padding:16px 16px 48px}
.top{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:14px}
.brand{display:flex;align-items:center;gap:10px;font-weight:600;color:var(--mute)}
.flag{display:flex;height:6px;width:72px;border-radius:3px;overflow:hidden;border:1px solid var(--line)}
.flag i{flex:1}.flag i:nth-child(1){background:#f77f00}.flag i:nth-child(2){background:#fff}.flag i:nth-child(3){background:#009e60}
h1{font-size:clamp(30px,9vw,44px);line-height:1.02;font-weight:800;letter-spacing:-.025em;margin:0 0 8px}
.lead{color:var(--mute);margin:0 0 18px;max-width:46ch}
:focus-visible{outline:3px solid var(--orange);outline-offset:2px}
.btn{font:inherit;font-weight:600;border:0;border-radius:10px;padding:10px 14px;background:var(--green);color:var(--on);cursor:pointer;text-decoration:none;display:inline-block;min-height:44px}
.btn.ghost{background:transparent;color:var(--ink);border:1px solid var(--line)}
.btn.wa{background:#1fa855;color:#fff}
.panel,details.pub{background:var(--card);border:1px solid var(--line);border-radius:14px;margin-bottom:22px}
.panel{padding:14px 16px;display:grid;gap:12px}
details.pub summary{list-style:none;cursor:pointer;padding:14px 16px;font-weight:800;font-size:18px;min-height:44px}
details.pub summary::-webkit-details-marker{display:none}
details.pub[open] summary{border-bottom:1px solid var(--line)}
.form{padding:14px 16px 16px;display:grid;gap:12px}
label{display:grid;gap:4px;font-weight:600;font-size:14px;color:var(--mute)}
input,select,textarea{font:inherit;font-size:16px;color:var(--ink);background:var(--page);border:1px solid var(--line);border-radius:10px;padding:10px 12px;width:100%}
textarea{min-height:96px;resize:vertical}
.row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.seg{display:flex;gap:6px;flex-wrap:wrap}
.seg button{font:inherit;font-weight:600;border:1px solid var(--line);background:var(--card);color:var(--ink);border-radius:999px;padding:8px 14px;cursor:pointer;min-height:44px}
.seg button.on{background:var(--ink);color:var(--page);border-color:var(--ink)}
.filters{display:grid;gap:10px;margin-bottom:14px}
.count{color:var(--mute);font-size:14px;margin:0 0 10px}
.post{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:14px 14px 12px 16px;margin-bottom:12px}
.post.cherche{border-left:5px solid var(--green)}
.post.offre{border-left:5px solid var(--orange)}
.meta{display:flex;flex-wrap:wrap;gap:6px 10px;align-items:center;font-size:13px;color:var(--mute)}
.tag{font-weight:800;border-radius:999px;padding:2px 10px}
.cherche .tag{background:var(--greenbg);color:var(--green)}
.offre .tag{background:var(--orangebg);color:var(--orange)}
.post h3{margin:8px 0 2px;font-size:19px;line-height:1.2}
.post h3 small{font-weight:400;color:var(--mute);font-size:15px;display:block}
.post p{margin:6px 0 10px;overflow-wrap:anywhere}
.acts{display:flex;gap:8px;flex-wrap:wrap}
.replies{margin-top:12px;border-top:1px solid var(--line);padding-top:8px}
.replies p{margin:6px 0;font-size:15px}
.rform{display:flex;gap:8px;margin-top:8px}
.empty{color:var(--mute);text-align:center;padding:28px 8px}
.note{font-size:13px;color:var(--mute);margin-top:24px}
.err{color:var(--orange);font-size:14px;margin:0;min-height:1em}
</style>
</head>
<body>
<div class="wrap">
  <div class="top"><div class="brand"><span class="flag"><i></i><i></i><i></i></span>Yako Emploi</div><button class="btn ghost" id="tog" type="button">Se connecter</button></div>
  <h1>Tu cherches du travail ? Dis-le ici.</h1>
  <p class="lead">Poste ton profil ou une offre, et les gens de ta ville te répondent.</p>

  <section class="panel" id="auth" hidden>
    <div class="seg" id="amode"><button type="button" class="on" data-a="in">Connexion</button><button type="button" data-a="up">Créer un compte</button></div>
    <label id="nl" hidden>Ton nom<input id="an" maxlength="40" autocomplete="name" placeholder="Ex. Kouassi A."></label>
    <label>E-mail<input id="ae" type="email" autocomplete="email" inputmode="email"></label>
    <label>Mot de passe (6 caractères minimum)<input id="ap" type="password" autocomplete="current-password"></label>
    <p class="err" id="aerr"></p>
    <button class="btn" id="ago" type="button">Se connecter</button>
  </section>

  <details class="pub" id="pub" hidden>
    <summary>Publier une annonce</summary>
    <div class="form">
      <div class="seg" id="ptype"><button type="button" class="on" data-t="cherche">Je cherche un travail</button><button type="button" data-t="offre">J’offre un travail</button></div>
      <div class="row">
        <label>Ton nom<input id="fn" maxlength="40" placeholder="Ex. Kouassi A."></label>
        <label>Ville<select id="fcity"></select></label>
      </div>
      <label>Catégorie de métier<select id="fd"></select></label>
      <label>Ton message<textarea id="fm" maxlength="400" placeholder="Parle de ton expérience, ou décris le poste."></textarea></label>
      <label>WhatsApp (facultatif, visible par tous)<input id="fw" type="tel" inputmode="tel" placeholder="Ex. 07 00 00 00 00"></label>
      <p class="err" id="err"></p>
      <button class="btn" id="send" type="button">Publier</button>
    </div>
  </details>

  <div class="filters">
    <div class="seg" id="ftype"><button type="button" class="on" data-f="tous">Tout</button><button type="button" data-f="cherche">Je cherche</button><button type="button" data-f="offre">J’offre</button></div>
    <div class="row"><select id="fcityf" aria-label="Filtrer par ville"></select><select id="fcatf" aria-label="Filtrer par catégorie"></select></div>
    <input id="q" type="search" placeholder="Rechercher un mot (couture, caissière…)" aria-label="Rechercher">
  </div>
  <p class="count" id="count"></p>
  <div id="list"></div>
  <button class="btn ghost" id="reload" type="button">Actualiser</button>
  <p class="note">Méfie-toi : un vrai employeur ne te demande jamais d’argent pour t’embaucher.</p>
</div>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.45.4/dist/umd/supabase.js"></script>
<script>
const sb=supabase.createClient("https://nazevlmgzbtbkhtdpnqy.supabase.co","sb_publishable_noD_yAq7D4Q_kvaBHA8o5w_-35dB_oV");
const CITIES=["Abidjan","Yamoussoukro","Bouaké","Daloa","San-Pédro","Korhogo","Man","Autre"];
const CATS=["Commerce et vente","Comptabilité et gestion","Couture et mode","Livraison et transport","Bâtiment et artisanat","Restauration","Informatique et digital","Santé","Éducation","Autre"];
const $=id=>document.getElementById(id);
const esc=s=>String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
let me=null,posts=[],ft="tous",fc="",fk="",q="",openId=null,pt="cherche",am="in";
const opt=(a,first)=>(first?`<option value="">${first}</option>`:"")+a.map(c=>`<option>${c}</option>`).join("");
$("fcity").innerHTML=opt(CITIES);$("fcityf").innerHTML=opt(CITIES,"Toutes les villes");
$("fd").innerHTML=opt(CATS);$("fcatf").innerHTML=opt(CATS,"Tous les métiers");
function ago(t){const m=Math.floor((Date.now()-new Date(t))/6e4);if(m<1)return "à l’instant";if(m<60)return "il y a "+m+" min";const h=Math.floor(m/60);if(h<24)return "il y a "+h+" h";return "il y a "+Math.floor(h/24)+" j"}
function waLink(w){let d=String(w||"").replace(/\D/g,"");if(!d)return "";if(d.length<=10)d="225"+d;return "https://wa.me/"+d}
function card(p){
  const wa=waLink(p.whatsapp),open=openId===p.id,rs=(p.replies||[]).slice().sort((a,b)=>a.created_at<b.created_at?-1:1);
  return `<article class="post ${p.kind}">
<div class="meta"><span class="tag">${p.kind==="cherche"?"Je cherche":"J’offre"}</span><span>${esc(p.city)}</span><span>${ago(p.created_at)}</span></div>
<h3>${esc(p.author)}<small>${esc(p.category)}</small></h3>
<p>${esc(p.message)}</p>
<div class="acts">${wa?`<a class="btn wa" href="${wa}" target="_blank" rel="noopener">Écrire sur WhatsApp</a>`:""}<button class="btn ghost" type="button" data-r="${p.id}">Réponses (${rs.length})</button>${me&&p.user_id===me.id?`<button class="btn ghost" type="button" data-x="${p.id}">Supprimer</button>`:""}</div>
${open?`<div class="replies">${rs.map(x=>`<p><b>${esc(x.author)}</b> ${esc(x.message)}</p>`).join("")}${me?`<div class="rform"><input id="ri" maxlength="200" placeholder="Écris une réponse"><button class="btn" type="button" data-s="${p.id}">Envoyer</button></div>`:'<p>Connecte-toi pour répondre.</p>'}</div>`:""}
</article>`}
function draw(){
  const l=posts.filter(p=>(ft==="tous"||p.kind===ft)&&(!fc||p.city===fc)&&(!fk||p.category===fk)&&(!q||(p.author+" "+p.category+" "+p.message+" "+p.city).toLowerCase().includes(q)));
  $("list").innerHTML=l.length?l.map(card).join(""):'<p class="empty">Aucune annonce ici pour l’instant. Publie la première !</p>';
  $("count").textContent=l.length+(l.length>1?" annonces":" annonce");
}
async function load(){
  const{data,error}=await sb.from("posts").select("*,replies(id,user_id,author,message,created_at)").order("created_at",{ascending:false}).limit(100);
  if(error){$("count").textContent="Impossible de charger les annonces. Vérifie ta connexion.";return}
  posts=data;draw();
}
function ui(){
  $("pub").hidden=!me;$("tog").textContent=me?"Déconnexion":"Se connecter";
  if(me){$("auth").hidden=true;const n=me.user_metadata&&me.user_metadata.name;if(n&&!$("fn").value)$("fn").value=n}
  draw();
}
function seg(box,attr,fn){box.addEventListener("click",e=>{const b=e.target.closest("button");if(!b)return;box.querySelectorAll("button").forEach(x=>x.classList.toggle("on",x===b));fn(b.dataset[attr])})}
seg($("ptype"),"t",v=>pt=v);
seg($("ftype"),"f",v=>{ft=v;draw()});
seg($("amode"),"a",v=>{am=v;$("nl").hidden=v==="in";$("ago").textContent=v==="in"?"Se connecter":"Créer mon compte"});
$("fcityf").onchange=e=>{fc=e.target.value;draw()};
$("fcatf").onchange=e=>{fk=e.target.value;draw()};
$("q").oninput=e=>{q=e.target.value.trim().toLowerCase();draw()};
$("reload").onclick=load;
$("tog").onclick=async()=>{if(me){await sb.auth.signOut()}else{$("auth").hidden=!$("auth").hidden}};
$("ago").onclick=async()=>{
  const email=$("ae").value.trim(),password=$("ap").value,name=$("an").value.trim();
  $("aerr").textContent="";
  if(am==="up"&&name.length<2){$("aerr").textContent="Ajoute ton nom.";return}
  const r=am==="in"?await sb.auth.signInWithPassword({email,password}):await sb.auth.signUp({email,password,options:{data:{name}}});
  if(r.error){$("aerr").textContent=am==="in"?"E-mail ou mot de passe incorrect.":"Inscription impossible. Vérifie l’e-mail et le mot de passe (6 caractères minimum).";return}
  if(am==="up"&&!r.data.session)$("aerr").textContent="Vérifie ta boîte mail pour confirmer ton compte, puis connecte-toi.";
};
$("list").addEventListener("click",async e=>{
  const r=e.target.closest("[data-r]"),s=e.target.closest("[data-s]"),x=e.target.closest("[data-x]");
  if(x){if(x.dataset.c){await sb.from("posts").delete().eq("id",x.dataset.x);load()}else{x.dataset.c=1;x.textContent="Confirmer ?"}return}
  if(r){openId=openId===r.dataset.r?null:r.dataset.r;draw()}
  if(s){const v=$("ri").value.trim();if(!v)return;const who=(me.user_metadata&&me.user_metadata.name)||"Anonyme";
    const{error}=await sb.from("replies").insert({post_id:s.dataset.s,author:who,message:v});if(!error)load()}
});
$("send").onclick=async()=>{
  const author=$("fn").value.trim(),message=$("fm").value.trim();
  if(author.length<2||message.length<10){$("err").textContent="Ajoute ton nom et un message d’au moins 10 caractères.";return}
  $("err").textContent="";
  const{error}=await sb.from("posts").insert({author,kind:pt,city:$("fcity").value,category:$("fd").value,message,whatsapp:$("fw").value.trim()||null});
  if(error){$("err").textContent="Publication impossible. Réessaie dans un instant.";return}
  $("fm").value="";$("pub").open=false;ft="tous";fc="";fk="";q="";$("q").value="";$("fcityf").value="";$("fcatf").value="";
  $("ftype").querySelectorAll("button").forEach(b=>b.classList.toggle("on",b.dataset.f==="tous"));
  load();
};
sb.auth.onAuthStateChange((_,s)=>{me=s?s.user:null;ui()});
load();
if("serviceWorker"in navigator)navigator.serviceWorker.register("sw.js").catch(()=>{});
</script>
</body>
</html>
